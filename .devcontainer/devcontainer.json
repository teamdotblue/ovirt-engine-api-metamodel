        "features": {
            "ghcr.io/devcontainers/features/java:1": {
                "version": "none",
                "installMaven": "false",
                "installGradle": "false"
            }
        },
        "postCreateCommand": "sudo apt-get update && sudo apt-get install -y maven"
}